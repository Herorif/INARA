# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
INARA_TEXT_MODEL=gemini-3.8-flash
# Optional shared token for manual backend/browser development.
# Electron generates and passes a token when it owns the backend process.
# INARA_SESSION_TOKEN=use_a_random_secret
# VITE_INARA_SESSION_TOKEN=the_same_secret_for_manual_browser_development

# Optional transcription override; otherwise uses INARA_TEXT_MODEL. Verify audio support before use.
# INARA_TRANSCRIPTION_MODEL=
