# API keys normally live in JARVIS's encrypted store, not in this file:
# Setup's AI providers step, scripts/bootstrap.ps1 -ConfigureKeys, or
#   .venv\Scripts\python.exe scripts\jarvis-secrets.py set gemini_api_key --verify
# (keys are read from stdin). See docs/AI_PROVIDERS.md.
# Developer override only: a real value set here (or in the environment) takes
# precedence over the store. Leave these commented to use the store.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
JARVIS_TEXT_MODEL=gemini-3.8-flash
# Optional Claude model overrides (the brain is used when an Anthropic key is set).
# JARVIS_BRAIN_MODEL=claude-sonnet-5-5
# JARVIS_FAST_MODEL=claude-haiku-5-5
# Optional shared token for manual backend/browser development.
# Electron generates and passes a token when it owns the backend process.
# JARVIS_SESSION_TOKEN=use_a_random_secret
# VITE_JARVIS_SESSION_TOKEN=the_same_secret_for_manual_browser_development

# Optional transcription override; otherwise uses JARVIS_TEXT_MODEL. Verify audio support before use.
# JARVIS_TRANSCRIPTION_MODEL=

# Optional standalone call bridge lab. No default: verify a current Live audio model.
# JARVIS_CALL_MODEL=
