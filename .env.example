# API keys normally live in INARA's encrypted store, not in this file:
# Setup's AI providers step, scripts/bootstrap.ps1 -ConfigureKeys, or
#   .venv\Scripts\python.exe scripts\inara-secrets.py set gemini_api_key --verify
# (keys are read from stdin). See docs/AI_PROVIDERS.md.
# Developer override only: a real value set here (or in the environment) takes
# precedence over the store. Leave these commented to use the store.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
INARA_TEXT_MODEL=gemini-3.8-flash
# Optional shared token for manual backend/browser development.
# Electron generates and passes a token when it owns the backend process.
# INARA_SESSION_TOKEN=use_a_random_secret
# VITE_INARA_SESSION_TOKEN=the_same_secret_for_manual_browser_development

# Optional transcription override; otherwise uses INARA_TEXT_MODEL. Verify audio support before use.
# INARA_TRANSCRIPTION_MODEL=

# Optional standalone call bridge lab. No default: verify a current Live audio model.
# INARA_CALL_MODEL=
