{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "JARVIS - General-Purpose AI Agent Platform",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"node --experimental-require-module node_modules/vite/bin/vite.js\" \"wait-on tcp:5173 && cross-env JARVIS_DEV_SERVER=1 node scripts/launch-native.cjs\"",
    "backend:dev": "python backend/server.py",
    "build": "node --experimental-require-module node_modules/vite/bin/vite.js build",
    "start": "node scripts/launch-native.cjs",
    "start:legacy": "electron .",
    "check:types": "node node_modules/typescript/lib/tsc.js -p tsconfig.ui.json",
    "test:client": "node --experimental-require-module --experimental-strip-types --test \"tests/*.mjs\" \"tests/*.cjs\"",
    "test:py": ".venv\\Scripts\\python.exe -m pytest -q -p no:cacheprovider",
    "lint:py": ".venv\\Scripts\\python.exe -m ruff check",
    "verify:overlay": "electron scripts/verify-overlay.cjs",
    "lint:js": "eslint --max-warnings 0 --report-unused-disable-directives src electron tests scripts *.config.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.16",
    "@types/three": "^0.160.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.300.0",
    "motion": "14.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^2.2.0",
    "three": "^0.160.0",
    "uplot": "1.6.32",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "44.9.3",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "5.0.4",
    "vite": "^7.3.7",
    "wait-on": "^9.5.1"
  }
}
