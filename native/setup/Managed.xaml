<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="INARA | Protected management" Width="1120" Height="900" MinWidth="760" MinHeight="680" Background="#080E16" Foreground="#E8F2F8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
<SolidColorBrush x:Key="Muted" Color="#9DB1C2"/>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="#0A1622"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="4"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#376371" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#091421"/><Setter Property="Foreground" Value="#E8F2F8"/><Setter Property="BorderBrush" Value="#294759"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="#6EF1DF"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="MaxLength" Value="2048"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#17313F"/><Setter Property="Foreground" Value="#E8F2F8"/><Setter Property="BorderBrush" Value="#31576A"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6EF1DF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#101E2B"/><Setter Property="BorderBrush" Value="#274151"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
<Style TargetType="RadioButton"><Setter Property="Foreground" Value="#D6E8F1"/><Setter Property="Margin" Value="0,0,20,12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#C0D7E5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="#112333" BorderBrush="#294759" BorderThickness="0,0,0,2" Padding="18,13" Margin="0,0,6,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#16434C"/><Setter TargetName="Tab" Property="BorderBrush" Value="#6EF1DF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid Margin="28,24,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Grid Width="52" Height="52" VerticalAlignment="Top"><Ellipse Stroke="#205767"/><Ellipse Margin="8" Stroke="#6EF1DF" StrokeThickness="2"/><Ellipse Margin="22" Fill="#6EF1DF"/><Path Data="M 26 0 L 26 10 M 26 42 L 26 52 M 0 26 L 10 26 M 42 26 L 52 26" Stroke="#6EF1DF"/></Grid>
<StackPanel Grid.Column="1"><TextBlock Text="I N A R A   /   CONTROL" Foreground="#6EF1DF" FontSize="11"/><TextBlock Text="Your system. In your hands." FontSize="27" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock Text="Protected updates and a clear way back." Foreground="{StaticResource Muted}"/></StackPanel>
<Border Grid.Column="2" Background="#14333A" BorderBrush="#2D676B" BorderThickness="1" CornerRadius="7" Padding="12,8" VerticalAlignment="Top"><TextBlock x:Name="ConnectionBadge" Text="CONNECTING" Foreground="#6EF1DF" FontSize="10"/></Border></Grid>
<ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01 / TRUSTED LOCATION" Foreground="#6EF1DF" FontSize="10"/><TextBlock Text="Choose the installation you own." FontSize="19" FontWeight="SemiBold" Margin="0,8,0,14"/>
<TextBlock Text="Installation folder" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="BrowseRoot" DockPanel.Dock="Right" Content="Choose..." Margin="10,5,0,12"/><TextBox x:Name="RootPath" AutomationProperties.Name="Installation folder"/></DockPanel>
<TextBlock Text="Separate checkpoint folder" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="BrowseAnchor" DockPanel.Dock="Right" Content="Choose..." Margin="10,5,0,12"/><TextBox x:Name="AnchorPath" AutomationProperties.Name="Separate checkpoint folder"/></DockPanel>
<TextBlock Text="Independently retained checkpoint pin" Foreground="{StaticResource Muted}"/><TextBox x:Name="StatePin" FontFamily="Consolas" MaxLength="64" AutomationProperties.Name="Independently retained checkpoint pin"/>
<TextBlock Text="Use your retained pin. Enter new only for first enrollment. A returned checkpoint is never accepted automatically." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
<WrapPanel><Button x:Name="CheckStatus" Content="Check protected status" Background="#145963" BorderBrush="#43BDBB"/><Button x:Name="CopyCheckpoint" Content="Copy returned checkpoint" IsEnabled="False"/></WrapPanel>
<Border Background="#0A1622" CornerRadius="8" Padding="14" Margin="0,4,0,0"><StackPanel><TextBlock x:Name="StateHeading" Text="Awaiting your checkpoint." Foreground="#6EF1DF" FontSize="16"/><TextBlock x:Name="StateDetails" Text="Checking status verifies protected metadata. It does not launch INARA or establish current launch eligibility." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
</StackPanel></Border>
<TabControl x:Name="Pages" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
<TabItem Header="02  Signed changes"><StackPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MOVE FORWARD. KEEP A WAY BACK." Foreground="#6EF1DF" FontSize="10"/><TextBlock Text="Review a signed change." FontSize="20" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Use externally signed grant and change files. Previous versions and profiles stay retained. Applying a change does not launch INARA." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
<WrapPanel><RadioButton x:Name="ActionUpdate" Content="Update" Tag="update" GroupName="Action" IsChecked="True"/><RadioButton x:Name="ActionRollback" Content="Rollback" Tag="rollback" GroupName="Action"/><RadioButton x:Name="ActionRenew" Content="Renew" Tag="renew" GroupName="Action"/><RadioButton x:Name="ActionRotate" Content="Rotate trust" Tag="rotate" GroupName="Action"/><RadioButton x:Name="ActionEnroll" Content="Enroll" Tag="enroll" GroupName="Action"/></WrapPanel>
<TextBlock Text="Signed launch grant file" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="BrowseGrant" DockPanel.Dock="Right" Content="Choose..." Margin="10,5,0,12"/><TextBox x:Name="GrantPath" AutomationProperties.Name="Signed launch grant file"/></DockPanel>
<TextBlock Text="Signed change file" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="BrowseChange" DockPanel.Dock="Right" Content="Choose..." Margin="10,5,0,12"/><TextBox x:Name="ChangePath" AutomationProperties.Name="Signed change file"/></DockPanel>
<TextBlock Text="Original signed package folder (required for a new version)" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="BrowsePackage" DockPanel.Dock="Right" Content="Choose..." Margin="10,5,0,12"/><TextBox x:Name="PackagePath" AutomationProperties.Name="Original signed package folder"/></DockPanel>
<TextBlock Text="Keep the original package at this path until the change or its recovery completes." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
<Expander x:Name="TrustFields" Header="Current trust and optional rotation inputs" Foreground="#D6E8F1" IsExpanded="True"><StackPanel Margin="0,14,0,0">
<TextBlock Text="Retained grant head pin" Foreground="{StaticResource Muted}"/><TextBox x:Name="HeadPin" MaxLength="64" FontFamily="Consolas" AutomationProperties.Name="Retained grant head pin"/>
<TextBlock Text="Current release policy file" Foreground="{StaticResource Muted}"/><TextBox x:Name="PolicyPath" AutomationProperties.Name="Current release policy file"/>
<TextBlock Text="Independent release policy pin" Foreground="{StaticResource Muted}"/><TextBox x:Name="PolicyPin" MaxLength="64" FontFamily="Consolas" AutomationProperties.Name="Independent release policy pin"/>
<TextBlock Text="Current Windows signing policy file" Foreground="{StaticResource Muted}"/><TextBox x:Name="WindowsPath" AutomationProperties.Name="Current Windows signing policy file"/>
<TextBlock Text="Independent Windows policy pin" Foreground="{StaticResource Muted}"/><TextBox x:Name="WindowsPin" MaxLength="64" FontFamily="Consolas" AutomationProperties.Name="Independent Windows policy pin"/>
<Expander Header="Proposed trust (rotation only)" Foreground="#D6E8F1"><StackPanel Margin="0,12,0,0">
<TextBlock Text="Proposed release policy file / independent pin" Foreground="{StaticResource Muted}"/><TextBox x:Name="NextPolicyPath" AutomationProperties.Name="Proposed release policy file"/><TextBox x:Name="NextPolicyPin" MaxLength="64" FontFamily="Consolas" AutomationProperties.Name="Proposed release policy pin"/>
<TextBlock Text="Proposed Windows policy file / independent pin" Foreground="{StaticResource Muted}"/><TextBox x:Name="NextWindowsPath" AutomationProperties.Name="Proposed Windows policy file"/><TextBox x:Name="NextWindowsPin" MaxLength="64" FontFamily="Consolas" AutomationProperties.Name="Proposed Windows policy pin"/>
</StackPanel></Expander></StackPanel></Expander>
<Button x:Name="ReviewChange" Content="Review signed change" HorizontalAlignment="Left" Background="#145963" BorderBrush="#43BDBB" Margin="0,18,0,0"/>
</StackPanel></Border></StackPanel></TabItem>
<TabItem Header="03  Interrupted change"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RECOVER WITH CONFIDENCE" Foreground="#6EF1DF" FontSize="10"/><TextBlock Text="Finish an interrupted change." FontSize="20" FontWeight="SemiBold" Margin="0,8,0,10"/>
<TextBlock Text="Enter the prepared checkpoint pin above and the previous committed pin below, both from your retained evidence. Preserve the journal and original package." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
<TextBlock Text="Previous checkpoint pin (or new for interrupted first enrollment)" Foreground="{StaticResource Muted}"/><TextBox x:Name="PreviousPin" MaxLength="64" FontFamily="Consolas" AutomationProperties.Name="Previous checkpoint pin"/>
<WrapPanel><Button x:Name="ReviewResume" Content="Review resume" Background="#145963" BorderBrush="#43BDBB"/><Button x:Name="ReviewAbort" Content="Review cancellation"/></WrapPanel>
<TextBlock Text="Cancellation is available only before metadata commit starts. It retains staged files and evidence. Once commit has started, use reviewed resume." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
<Border Background="#182936" Padding="14" CornerRadius="8"><TextBlock Text="Recovery also resumes signed profile selection and removal. Cancellation refuses after the first deletion. Data-erasure resumption requires its exact confirmation phrase again." Foreground="#B9D1DF"/></Border>
</StackPanel></Border></TabItem>
<TabItem Header="04  Profiles"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="YOUR WORK / A PROTECTED WAY BACK" Foreground="#6EF1DF" FontSize="10"/><TextBlock Text="Back up. Prepare. Review." FontSize="20" FontWeight="SemiBold" Margin="0,8,0,10"/>
<TextBlock Text="Stop INARA first. Backups unlock with the original Windows account and exact installed version. Preparing a compatible recovery copy preserves the current selection; activation is a separate signed change." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
<TextBlock Text="Installed version identifier" Foreground="{StaticResource Muted}"/><TextBox x:Name="ProfileSlot" MaxLength="64" FontFamily="Consolas" AutomationProperties.Name="Profile version identifier"/>
<TextBlock Text="Encrypted backup file (outside installation and checkpoints)" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="NewBackupFile" DockPanel.Dock="Right" Content="New..." Margin="10,5,0,12"/><Button x:Name="OpenBackupFile" DockPanel.Dock="Right" Content="Open..." Margin="10,5,0,12"/><TextBox x:Name="BackupFile" AutomationProperties.Name="Encrypted backup file"/></DockPanel>
<Button x:Name="ReviewBackup" Content="Review encrypted backup" HorizontalAlignment="Left" Background="#145963" BorderBrush="#43BDBB"/>
<Separator Margin="0,14,0,18" Background="#294250"/>
<TextBlock Text="New recovery profile identifier" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="NewProfileId" DockPanel.Dock="Right" Content="Generate ID" Margin="10,5,0,12"/><TextBox x:Name="RecoveryProfile" MaxLength="32" FontFamily="Consolas" AutomationProperties.Name="New recovery profile identifier"/></DockPanel>
<Button x:Name="ReviewPrepareProfile" Content="Review recovery copy" HorizontalAlignment="Left"/>
<TextBlock Text="Unknown record types, changed owners, incompatible scopes and altered artifacts stop recovery. Incomplete copies are preserved. Use a signed activation envelope on the Lifecycle page only after preparation succeeds." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
</StackPanel></Border></TabItem>
<TabItem Header="05  Lifecycle"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SEPARATE CHANGES / EXACT AUTHORIZATION" Foreground="#6EF1DF" FontSize="10"/><TextBlock Text="Choose what changes. Keep the evidence." FontSize="20" FontWeight="SemiBold" Margin="0,8,0,10"/>
<TextBlock Text="A separately signed lifecycle envelope can activate a prepared profile, return to the previous profile, remove software while retaining data, or erase retained profiles after software removal." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
<TextBlock Text="Signed lifecycle envelope file" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="BrowseLifecycle" DockPanel.Dock="Right" Content="Choose..." Margin="10,5,0,12"/><TextBox x:Name="LifecyclePath" AutomationProperties.Name="Signed lifecycle envelope file"/></DockPanel>
<Button x:Name="ReviewLifecycle" Content="Review signed lifecycle change" HorizontalAlignment="Left" Background="#145963" BorderBrush="#43BDBB"/>
<Border Background="#182936" CornerRadius="8" Padding="14" Margin="0,14,0,0"><TextBlock Text="Software removal keeps profiles, external backups, signatures, checkpoints and admission evidence. Profile erasure is separate and requires typing ERASE INARA DATA. Encrypted deletion inventories and trust metadata remain for audit/recovery. This is file removal, not secure disk sanitization." Foreground="#B9D1DF"/></Border>
<TextBlock Text="Prepare a lifecycle signing request with the trusted controller, then have the enrolled publisher and reviewer cohorts sign it externally. This window holds no signing keys." Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
</StackPanel></Border></TabItem></TabControl>
<Border x:Name="ReviewCard" Style="{StaticResource Card}" BorderBrush="#6EF1DF" Visibility="Collapsed"><StackPanel><TextBlock Text="04 / YOUR REVIEW" Foreground="#6EF1DF" FontSize="10"/><TextBlock x:Name="ReviewHeading" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,12"/>
<TextBox x:Name="ReviewDetails" IsReadOnly="True" MaxLength="0" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" MaxHeight="350" AutomationProperties.Name="Exact reviewed change"/>
<TextBlock Text="Retain the prepared and previous checkpoint pins before confirming. A review expires after five minutes. Editing an input clears confirmation; apply rechecks the exact signed change and state." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
<StackPanel x:Name="ErasePrompt" Visibility="Collapsed"><TextBlock Text="Type ERASE INARA DATA to confirm profile file erasure." Foreground="#F0A5AF"/><TextBox x:Name="EraseConfirmation" AutomationProperties.Name="Exact data erasure confirmation"/></StackPanel>
<WrapPanel><Button x:Name="CancelReview" Content="Back"/><Button x:Name="ConfirmReview" Content="Confirm reviewed change" Background="#145963" BorderBrush="#43BDBB" IsEnabled="False"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Margin="0,10,0,0"><ProgressBar x:Name="Progress" Height="3" Foreground="#6EF1DF" Background="#203545" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Verifying the protected controller before connecting..." Foreground="#B2CADA" FontSize="12" Margin="0,10,0,5" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Local management / manual startup / no automatic launch" Foreground="#68869C" FontSize="10"/></StackPanel>
</Grid></Window>
