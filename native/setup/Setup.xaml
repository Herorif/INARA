<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="INARA | Setup &amp; recovery" Width="1120" Height="850" MinWidth="780" MinHeight="680" Background="#080E16" Foreground="#E8F2F8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
<SolidColorBrush x:Key="Muted" Color="#9DB1C2"/>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#152837"/><Setter Property="Foreground" Value="#E8F2F8"/><Setter Property="BorderBrush" Value="#2B485B"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5EE7E0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#0A131F"/><Setter Property="Foreground" Value="#E8F2F8"/><Setter Property="BorderBrush" Value="#2B485B"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="#5EE7E0"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E8F2F8"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="#101D2A" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#234651"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#145963"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E8F2F8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="#0A131F" Foreground="#E8F2F8" BorderBrush="#2B485B" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="v" Foreground="#69DDD9" Margin="12,0,0,0"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" HorizontalAlignment="Left"/></DockPanel></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#101D2A" BorderBrush="#3C6372" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#101D2A"/><Setter Property="BorderBrush" Value="#243D50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
</Window.Resources>
<Grid Background="#080E16"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0C1722" BorderBrush="#203545" BorderThickness="0,0,1,0"><DockPanel Margin="20,30,16,22">
<StackPanel DockPanel.Dock="Top"><Grid Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,14"><Ellipse Stroke="#1E6674" StrokeThickness="1"/><Ellipse Margin="9" Stroke="#5EE7E0" StrokeThickness="2"/><Ellipse Margin="24" Fill="#5EE7E0"/><Path Data="M 32 0 L 32 13 M 32 51 L 32 64 M 0 32 L 13 32 M 51 32 L 64 32" Stroke="#5EE7E0" StrokeThickness="2"/></Grid><TextBlock Text="I N A R A" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="YOUR DESKTOP COMPANION" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,7,0,36"/>
<Button x:Name="NavHome" Content="01   Installation" HorizontalContentAlignment="Left"/><Button x:Name="NavRecovery" Content="02   Recovery"/><Button x:Name="NavRemove" Content="03   Remove"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border BorderBrush="#244A58" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,12"><TextBlock Text="LOCAL PILOT" Foreground="#6DE5DE" FontSize="10"/></Border><TextBlock Text="Publisher signing and clean-machine acceptance are pending." FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="Startup stays manual." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel><Grid/>
</DockPanel></Border>
<Grid Grid.Column="1" Margin="30,25,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="Eyebrow" Text="DESKTOP / SETUP" Foreground="#69DDD9" FontSize="10" Margin="0,0,0,8"/><TextBlock x:Name="PageTitle" Text="A home for INARA." FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="Install locally. Choose your version. Keep your work." Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
<TextBlock Text="Installation folder" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><DockPanel><Button x:Name="BrowseRoot" DockPanel.Dock="Right" Content="Existing&#x2026;"/><Button x:Name="NewRoot" DockPanel.Dock="Right" Content="New&#x2026;"/><Button x:Name="CheckRoot" DockPanel.Dock="Right" Content="Check"/><TextBox x:Name="RootPath" ToolTip="Choose an existing managed installation or enter a new folder."/></DockPanel></StackPanel>
<ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>
<StackPanel x:Name="HomePage"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01 / SOFTWARE" Foreground="#69DDD9" FontSize="10"/><TextBlock Text="Bring INARA onto this PC." FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="A fresh install starts with its own data. Installing a version does not launch it." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><TextBlock Text="Package folder" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><DockPanel><Button x:Name="BrowsePackage" DockPanel.Dock="Right" Content="Choose&#x2026;"/><TextBox x:Name="PackagePath"/></DockPanel><WrapPanel><Button x:Name="InstallButton" Content="Review installation" Background="#145963" BorderBrush="#43BDBB"/><Button x:Name="ResumeButton" Content="Resume interrupted removal" Visibility="Collapsed"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02 / YOUR VERSIONS" Foreground="#69DDD9" FontSize="10"/><TextBlock x:Name="VersionStatus" Text="Check the installation folder to see its versions." FontSize="18" Margin="0,8,0,12"/><ComboBox x:Name="Versions" DisplayMemberPath="label"/><WrapPanel><Button x:Name="SelectButton" Content="Use selected version"/><Button x:Name="RollbackButton" Content="Previous version"/></WrapPanel><Separator Margin="0,7,0,14" Background="#294250"/><CheckBox x:Name="OpenWorkspace" Content="Open the full workspace when launching" Foreground="#D8E7F0" Margin="0,0,0,12"/><Button x:Name="LaunchButton" Content="Launch INARA" HorizontalAlignment="Left" Background="#145963" BorderBrush="#43BDBB"/><TextBlock Text="Otherwise INARA starts quietly in the tray. Launching never enables startup at sign-in." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border></StackPanel>
<StackPanel x:Name="RecoveryPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="YOUR WORK, KEPT CLOSE" Foreground="#69DDD9" FontSize="10"/><TextBlock Text="An encrypted way back." FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Backups unlock with the original Windows account and matching installed version. Quit INARA before recovery operations." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><TextBlock Text="Use the version selected on the Installation page." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/><DockPanel><Button x:Name="SaveBackup" DockPanel.Dock="Right" Content="New backup&#x2026;"/><Button x:Name="OpenBackup" DockPanel.Dock="Right" Content="Open&#x2026;"/><TextBox x:Name="BackupPath" ToolTip="Encrypted .inara backup file"/></DockPanel><WrapPanel><Button x:Name="BackupButton" Content="Review backup"/><Button x:Name="PrepareButton" Content="Review recovery copy"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PREPARED RECOVERY" Foreground="#69DDD9" FontSize="10"/><TextBlock Text="Review first. Switch when ready." FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Compatible project data gets a new home. Unsupported records stop the review. Your original profile stays available for rollback." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><TextBox x:Name="PreparedProfile" ToolTip="Profile identifier returned after preparing a copy"/><WrapPanel><Button x:Name="ActivateRecovery" Content="Review activation"/><Button x:Name="RollbackRecovery" Content="Previous profile"/></WrapPanel></StackPanel></Border></StackPanel>
<StackPanel x:Name="RemovePage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SOFTWARE ONLY" Foreground="#69DDD9" FontSize="10"/><TextBlock Text="Remove INARA. Keep your work." FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Removes installed version files and clears the selected version. Settings, projects, profiles and recovery copies stay in this installation folder." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><Button x:Name="UninstallButton" Content="Review software removal" HorizontalAlignment="Left"/></StackPanel></Border>
<Border Style="{StaticResource Card}" BorderBrush="#71454F"><StackPanel><TextBlock Text="SEPARATE DATA REMOVAL" Foreground="#F0A5AF" FontSize="10"/><TextBlock Text="Erase retained profiles." FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Available after software removal. Permanently deletes the owned settings, projects and recovery copies here. External encrypted backup files are retained." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><Button x:Name="EraseButton" Content="Review permanent data erasure" HorizontalAlignment="Left" BorderBrush="#AB6570"/></StackPanel></Border></StackPanel>
<Border x:Name="ReviewCard" Style="{StaticResource Card}" BorderBrush="#4FC6C1" Visibility="Collapsed"><StackPanel><TextBlock Text="REVIEW CHANGES" Foreground="#69DDD9" FontSize="10"/><TextBlock x:Name="ReviewHeading" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,10"/><TextBox x:Name="ReviewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="230" Background="#0C1722"/><StackPanel x:Name="ErasePrompt" Visibility="Collapsed"><TextBlock Text="Type ERASE INARA DATA to confirm permanent data erasure." Foreground="#F0A5AF" Margin="0,6,0,8"/><TextBox x:Name="EraseConfirmation"/></StackPanel><WrapPanel><Button x:Name="CancelReview" Content="Back"/><Button x:Name="ConfirmReview" Content="Confirm" Background="#145963" BorderBrush="#43BDBB"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Margin="0,8,0,0"><ProgressBar x:Name="Progress" Height="3" Foreground="#5EE7E0" Background="#203545" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Checking the local control package?" Foreground="#A6BECE" Margin="0,9,0,0" FontSize="12" AutomationProperties.LiveSetting="Polite"/></StackPanel>
</Grid></Grid></Window>