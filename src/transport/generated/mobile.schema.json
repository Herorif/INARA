{
  "ListenerRequest": {
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "title": "Enabled",
        "type": "boolean"
      },
      "host": {
        "default": "127.0.0.1",
        "title": "Host",
        "type": "string"
      },
      "port": {
        "default": 8443,
        "maximum": 65535,
        "minimum": 1024,
        "title": "Port",
        "type": "integer"
      }
    },
    "required": [
      "enabled"
    ],
    "title": "ListenerRequest",
    "type": "object"
  },
  "PairRequest": {
    "additionalProperties": false,
    "properties": {
      "allow_chat": {
        "default": false,
        "title": "Allow Chat",
        "type": "boolean"
      }
    },
    "title": "PairRequest",
    "type": "object"
  },
  "PairDecision": {
    "additionalProperties": false,
    "properties": {
      "device_id": {
        "format": "uuid",
        "title": "Device Id",
        "type": "string"
      },
      "approved": {
        "title": "Approved",
        "type": "boolean"
      }
    },
    "required": [
      "device_id",
      "approved"
    ],
    "title": "PairDecision",
    "type": "object"
  },
  "DeviceRequest": {
    "additionalProperties": false,
    "properties": {
      "device_id": {
        "format": "uuid",
        "title": "Device Id",
        "type": "string"
      }
    },
    "required": [
      "device_id"
    ],
    "title": "DeviceRequest",
    "type": "object"
  },
  "PairClaim": {
    "additionalProperties": false,
    "properties": {
      "challenge_id": {
        "format": "uuid",
        "title": "Challenge Id",
        "type": "string"
      },
      "secret": {
        "maxLength": 43,
        "minLength": 43,
        "title": "Secret",
        "type": "string"
      },
      "name": {
        "maxLength": 60,
        "minLength": 1,
        "pattern": "^[\\w .()\\-]+$",
        "title": "Name",
        "type": "string"
      },
      "public_key": {
        "maxLength": 256,
        "minLength": 100,
        "title": "Public Key",
        "type": "string"
      }
    },
    "required": [
      "challenge_id",
      "secret",
      "name",
      "public_key"
    ],
    "title": "PairClaim",
    "type": "object"
  },
  "SignedEnvelope": {
    "additionalProperties": false,
    "properties": {
      "device_id": {
        "format": "uuid",
        "title": "Device Id",
        "type": "string"
      },
      "request_id": {
        "format": "uuid",
        "title": "Request Id",
        "type": "string"
      },
      "timestamp": {
        "title": "Timestamp",
        "type": "integer"
      },
      "signature": {
        "maxLength": 128,
        "minLength": 80,
        "title": "Signature",
        "type": "string"
      },
      "payload": {
        "maxLength": 24000,
        "title": "Payload",
        "type": "string"
      }
    },
    "required": [
      "device_id",
      "request_id",
      "timestamp",
      "signature",
      "payload"
    ],
    "title": "SignedEnvelope",
    "type": "object"
  },
